# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored by default.

# Base URL of the backend API (include the /api suffix).
# Local dev:   http://localhost:5000/api
# Production:  https://your-api.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# GitHub Personal Access Token (optional)
# - Boosts the live GitHub stats rate limit from 60/hour to 5000/hour
# - Create one at https://github.com/settings/tokens (read-only is fine)
